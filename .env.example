# Application Configuration
APP_NAME=Microservice DevOps Lab
APP_VERSION=2.0.0
DEBUG=false

# Database Configuration
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=labdb
POSTGRES_USER=labuser
POSTGRES_PASSWORD=labpass

# Connection Pool Configuration
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=20

# API Configuration
API_PREFIX=/api/v1
ALLOWED_HOSTS=localhost,127.0.0.1
# Add frontend origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:8000

# Monitoring Configuration
ENABLE_METRICS=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/tmp/app.log

# Security Configuration
SECRET_KEY=change-this-to-a-secure-secret-key-in-production